# Café am Lindenplatz – environment variables
# Copy to `.env.local` for local development; set the same names in the hosting provider
# (e.g. Vercel → Project → Settings → Environment Variables). Never commit real values.
# Everything works without these: Sanity off = verified legacy content, e-mail off = form disabled.

# ---------------------------------------------------------------------------
# Sanity CMS (public identifiers, not secrets: they are also used by the Studio in the browser)
# ---------------------------------------------------------------------------
# Project ID from https://www.sanity.io/manage (lowercase letters/digits).
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset name, usually "production".
NEXT_PUBLIC_SANITY_DATASET=
# Optional: pinned API version (default 2026-03-01). Only change deliberately.
# NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01

# ---------------------------------------------------------------------------
# Contact form e-mail delivery via Resend (SERVER-ONLY secrets; never prefix with NEXT_PUBLIC_)
# Sending happens only when ALL four values are set and valid.
# ---------------------------------------------------------------------------
# Master switch. Exactly "true" enables sending; anything else keeps the form disabled.
CONTACT_FORM_ENABLED=false
# Resend API key with "sending access" only (starts with re_). https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender on a domain verified in Resend, e.g.: Website Café am Lindenplatz <kontakt@your-domain.de>
CONTACT_FROM_EMAIL=
# The café's confirmed inbox that receives the messages (exactly one address).
CONTACT_TO_EMAIL=

# ---------------------------------------------------------------------------
# Optional: shared rate limiting across serverless instances (Upstash Redis REST)
# Without it, the limit (5 messages / 10 min per visitor) only applies per server instance.
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
